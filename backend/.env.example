# AI reasoning via OpenRouter. Copy the key from the InsForge dashboard (Model Gateway).
# Keep it server-side only. Never put it in the frontend.
OPENROUTER_API_KEY=
# Any OpenRouter model id. Empty = anthropic/claude-sonnet-5.5
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_RETRIES=2
CORS_ORIGINS=http://localhost:3000

# InsForge: verifies the signed-in user and saves investigation history.
# The backend writes with the user's own token, so no admin key is needed here.
INSFORGE_BASE_URL=https://your-app.region.insforge.app
# false = allow POST /investigate without sign-in (local curl testing; no history is saved)
AUTH_REQUIRED=true

# Kubernetes access. Empty = kubectl default (KUBECONFIG env var, then ~/.kube/config).
# Docker Compose sets this for you inside the container.
KUBECONFIG_PATH=
KUBECTL_BINARY=kubectl
KUBECTL_TIMEOUT_SECONDS=20

# Investigation limits (keep the payload small)
LOG_TAIL_LINES=200
MAX_LOG_LINES_PER_CONTAINER=30
MAX_PODS_FOR_LOGS=10
STUCK_CONTAINER_CREATING_MINUTES=5
